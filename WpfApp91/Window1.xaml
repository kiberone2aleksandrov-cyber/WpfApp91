<Window x:Class="WpfApp91.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp91"
        mc:Ignorable="d"
        Width="1903"  
        Height="1085"
        Title="Window1">
    <Grid Width="1920" Height="1080">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1920"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF6F6F6F" Offset="0.348"/>
                <GradientStop Color="#FF2B2B2B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Button x:Name="BUMAGA" Content="" HorizontalAlignment="Left" Margin="176,0,0,0" VerticalAlignment="Center" Height="308" Width="360" Click="Button_Click_2" BorderThickness="0,0,0,0" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
            <Button.Background>
                <ImageBrush ImageSource="/i.png" Stretch="Fill"/>
            </Button.Background>

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="50">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <Button x:Name="NOJNICI" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Height="308" Width="470" RenderTransformOrigin="0.5,0.5" Click="Button_Click" Padding="1,1,1,5" BorderThickness="0,0,0,0">
            <Button.Background>
                <ImageBrush ImageSource="/i (1).png" Stretch="Fill"/>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="50">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Label Content="ВЫБЕРИТЕ ПРЕДМЕТ" FontWeight="Bold" Foreground="White" FontSize="50" HorizontalAlignment="Center" Margin="0,776,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.393,0.498"/>
        <Button Content="" HorizontalAlignment="Left" FontSize="30" FontWeight="Bold" Margin="10,10,0,0" VerticalAlignment="Top" Height="135" Width="133" RenderTransformOrigin="0.5,0.5" Click="Button_Click_1">
            <Button.Resources>
                <Style TargetType ="Border">
                    <Setter Property="CornerRadius" Value="15">
                    </Setter>
                </Style>
            </Button.Resources>
            <Button.Background>
                <ImageBrush ImageSource="/a09adb8722a63ec83e233132ed3e5eaf-no-bg-preview (carve.photos).png" Stretch="UniformToFill"/>
            </Button.Background>


        </Button>

        <Label Content="Результат:" FontSize="40" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,29,0,0" VerticalAlignment="Top"/>

        <Button x:Name="KAMEN" Content="" HorizontalAlignment="Left" Margin="1375,0,0,0" VerticalAlignment="Center" Height="308" Width="360" RenderTransformOrigin="0.5,0.5" Click="Button_Click3" BorderThickness="0,0,0,0">
            <Button.Background>
                <ImageBrush ImageSource="/i (2).png"/>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="50">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Label x:Name="labelResult" Foreground="LightGray" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,114,0,0" VerticalAlignment="Top" Height="97" Width="708" FontFamily="Arial Black">

        </Label>
        <TextBox  HorizontalAlignment="Left" Text=""  MaxLength="8" Margin="10,891,0,0" FontSize="25" TextWrapping="Wrap"  VerticalAlignment="Top" Width="245" Height="52"  BorderBrush="#FFAFAFAF" SelectionBrush="White" SelectionTextBrush="White" Foreground="DarkGray" x:Name="textbox1" TextChanged="TextBox_TextChanged">
            <TextBox.Style>
                <Style TargetType="TextBox" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                    <Style.Resources>
                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <Label Content="Введите⠀ник⠀" Foreground="LightGray"  />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Style.Resources>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Label Content="Побед:" HorizontalAlignment="Left" Foreground="White" FontSize="50" FontWeight="Bold"  Margin="813,858,0,0" VerticalAlignment="Top"/>
        <Label x:Name="POBEDA_label" Content="0" FontSize="40" HorizontalAlignment="Left" Margin="1016,869,0,0" Foreground="White" FontWeight="Bold" VerticalAlignment="Top" RenderTransformOrigin="-1.671,0.583"/>
        <Label x:Name="achievment" Content="открыто достижение: победитель по жизни" FontSize="30" Visibility="Hidden" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" Margin="1245,10,0,0" VerticalAlignment="Top" Height="46" Width="665"/>
        <Label x:Name="NICK_WIN"  Foreground="LightGray" Content="" HorizontalAlignment="Left" Margin="877,232,0,0" VerticalAlignment="Top" Height="65" Width="318" FontSize="48" FontFamily="Segoe UI Black"/>
        <Label x:Name="nick_label"  Foreground="LightGray" Content="            ТЫ" HorizontalAlignment="Left" Margin="606,232,0,0" VerticalAlignment="Top" Height="105" Width="318" FontSize="48" FontFamily="Segoe UI Black" Visibility="Hidden"/>
        <Label Content="Максимум 8 символов" FontSize="22" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,943,0,0" VerticalAlignment="Top" Height="39" Width="284"/>





    </Grid>
</Window>
